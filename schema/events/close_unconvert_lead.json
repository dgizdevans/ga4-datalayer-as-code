{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dgizdevans/ga4-datalayer-as-code/main/schema/events/close_unconvert_lead.json",
  "title": "close_unconvert_lead",
  "description": "Lead closed as not converted.",
  "type": "object",
  "x-event-class": "recommended",
  "allOf": [
    {
      "$ref": "../shared/envelope.json"
    },
    {
      "$ref": "../shared/common_web_params.json"
    },
    {
      "$ref": "../shared/money_dependency.json"
    }
  ],
  "required": [
    "event"
  ],
  "properties": {
    "event": {
      "const": "close_unconvert_lead"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code. Required whenever value is present.",
      "examples": [
        "EUR"
      ],
      "x-pii": false,
      "x-sensitivity": "none"
    },
    "value": {
      "type": "number",
      "description": "Monetary value of the event in the given currency.",
      "examples": [
        129.99
      ],
      "x-pii": false,
      "x-sensitivity": "none"
    },
    "unconvert_lead_reason": {
      "type": "string",
      "description": "Reason the lead closed without converting.",
      "examples": [
        "lost_to_competitor"
      ],
      "x-pii": false,
      "x-sensitivity": "none"
    }
  },
  "unevaluatedProperties": false
}
