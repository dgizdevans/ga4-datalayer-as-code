{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dgizdevans/ga4-datalayer-as-code/main/schema/events/click.json",
  "title": "click",
  "description": "Outbound link click captured by Enhanced Measurement.",
  "type": "object",
  "x-event-class": "enhanced_measurement",
  "allOf": [
    {
      "$ref": "../shared/envelope.json"
    },
    {
      "$ref": "../shared/common_web_params.json"
    }
  ],
  "required": [
    "event"
  ],
  "properties": {
    "event": {
      "const": "click"
    },
    "link_classes": {
      "type": "string",
      "description": "CSS classes of the clicked link.",
      "examples": [
        "nav-link primary"
      ],
      "x-pii": false,
      "x-sensitivity": "none"
    },
    "link_domain": {
      "type": "string",
      "description": "Domain of the clicked outbound link.",
      "examples": [
        "partner.example.org"
      ],
      "x-pii": false,
      "x-sensitivity": "none"
    },
    "link_id": {
      "type": "string",
      "description": "DOM id of the clicked link.",
      "examples": [
        "footer-contact"
      ],
      "x-pii": false,
      "x-sensitivity": "none"
    },
    "link_url": {
      "type": "string",
      "description": "Destination URL of the clicked link.",
      "examples": [
        "https://partner.example.org/offer"
      ],
      "x-pii": false,
      "x-sensitivity": "none"
    },
    "outbound": {
      "type": "boolean",
      "description": "True when the click leads outside the current domain.",
      "examples": [
        true
      ],
      "x-pii": false,
      "x-sensitivity": "none"
    }
  },
  "unevaluatedProperties": false
}
