{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dgizdevans/ga4-datalayer-as-code/main/schema/events/join_group.json",
  "title": "join_group",
  "description": "User joined a group or community.",
  "type": "object",
  "x-event-class": "recommended",
  "allOf": [
    {
      "$ref": "../shared/envelope.json"
    },
    {
      "$ref": "../shared/common_web_params.json"
    }
  ],
  "required": [
    "event"
  ],
  "properties": {
    "event": {
      "const": "join_group"
    },
    "group_id": {
      "type": "string",
      "description": "Identifier of the joined group.",
      "examples": [
        "team_42"
      ],
      "x-pii": false,
      "x-sensitivity": "none"
    }
  },
  "unevaluatedProperties": false
}
