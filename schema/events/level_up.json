{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dgizdevans/ga4-datalayer-as-code/main/schema/events/level_up.json",
  "title": "level_up",
  "description": "User reached a new level.",
  "type": "object",
  "x-event-class": "recommended",
  "allOf": [
    {
      "$ref": "../shared/envelope.json"
    },
    {
      "$ref": "../shared/common_web_params.json"
    }
  ],
  "required": [
    "event"
  ],
  "properties": {
    "event": {
      "const": "level_up"
    },
    "level": {
      "type": "number",
      "description": "Numeric level reached.",
      "examples": [
        5
      ],
      "x-pii": false,
      "x-sensitivity": "none"
    },
    "character": {
      "type": "string",
      "description": "Character or persona in play.",
      "examples": [
        "default"
      ],
      "x-pii": false,
      "x-sensitivity": "none"
    }
  },
  "unevaluatedProperties": false
}
