{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dgizdevans/ga4-datalayer-as-code/main/schema/events/unlock_achievement.json",
  "title": "unlock_achievement",
  "description": "Achievement unlocked.",
  "type": "object",
  "x-event-class": "recommended",
  "allOf": [
    {
      "$ref": "../shared/envelope.json"
    },
    {
      "$ref": "../shared/common_web_params.json"
    }
  ],
  "required": [
    "event",
    "achievement_id"
  ],
  "properties": {
    "event": {
      "const": "unlock_achievement"
    },
    "achievement_id": {
      "type": "string",
      "description": "Identifier of the unlocked achievement.",
      "examples": [
        "first_purchase"
      ],
      "x-pii": false,
      "x-sensitivity": "none"
    }
  },
  "unevaluatedProperties": false
}
