{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dgizdevans/ga4-datalayer-as-code/main/schema/events/view_item_list.json",
  "title": "view_item_list",
  "description": "List of items viewed.",
  "type": "object",
  "x-event-class": "ecommerce",
  "allOf": [
    {
      "$ref": "../shared/envelope.json"
    },
    {
      "$ref": "../shared/common_web_params.json"
    },
    {
      "$ref": "../shared/money_dependency.json"
    }
  ],
  "required": [
    "event",
    "items"
  ],
  "properties": {
    "event": {
      "const": "view_item_list"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code. Required whenever value is present.",
      "examples": [
        "EUR"
      ],
      "x-pii": false,
      "x-sensitivity": "none"
    },
    "value": {
      "type": "number",
      "description": "Monetary value of the event in the given currency.",
      "examples": [
        129.99
      ],
      "x-pii": false,
      "x-sensitivity": "none"
    },
    "item_list_id": {
      "type": "string",
      "description": "Identifier of the list the item(s) belong to.",
      "examples": [
        "search_results"
      ],
      "x-pii": false,
      "x-sensitivity": "none"
    },
    "item_list_name": {
      "type": "string",
      "description": "Human-readable name of the list.",
      "examples": [
        "Search results"
      ],
      "x-pii": false,
      "x-sensitivity": "none"
    },
    "items": {
      "$ref": "../shared/items.json"
    }
  },
  "unevaluatedProperties": false
}
